# Odoo connection
ODOO_URL=https://odoo.example.com
ODOO_DB=odoo
ODOO_USER=api-user@example.com
ODOO_API_KEY=change-me
# jsonrpc | xmlrpc | json2
ODOO_PROTOCOL=jsonrpc
ODOO_TIMEOUT_SECONDS=10
ODOO_MAX_RETRIES=2
# Optional: default company for multi-company databases
ODOO_COMPANY_ID=

# Connector security
# Optional: when set, clients must send it in the X-API-Key header
CONNECTOR_API_KEY=
# Shared secret for HMAC SHA256 verification of X-Odoo-Signature
WEBHOOK_SECRET=change-me

# Persistence and logging
IDEMPOTENCY_DB_PATH=idempotency.sqlite3
LOG_LEVEL=INFO
