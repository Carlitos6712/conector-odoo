# Odoo connection
ODOO_URL=https://odoo.example.com
ODOO_DB=odoo
ODOO_USER=api-user@example.com
# At least 16 characters (Odoo API keys are 40 characters)
ODOO_API_KEY=change-me
# jsonrpc | xmlrpc | json2
ODOO_PROTOCOL=jsonrpc
ODOO_TIMEOUT_SECONDS=10
ODOO_MAX_RETRIES=2
# Optional: default company for multi-company databases
ODOO_COMPANY_ID=
# Max Odoo calls in flight at once (1-64); also the HTTP connection pool size
ODOO_MAX_CONCURRENCY=8
# Default page size for keyset iteration and chunked operations (1-5000)
ODOO_BATCH_SIZE=500

# Bulk import
# Max items accepted by one POST /customers/bulk request (1-10000)
BULK_MAX_ITEMS=1000

# Connector security
# Optional: when set, clients must send it in the X-API-Key header (at least 16 characters)
CONNECTOR_API_KEY=
# Shared secret for HMAC SHA256 verification of X-Odoo-Signature (at least 16 characters)
WEBHOOK_SECRET=change-me
# Max clock skew between the signed timestamp and the connector clock
WEBHOOK_TOLERANCE_SECONDS=300
# A received-but-unprocessed event is re-dispatched on redelivery after this long
WEBHOOK_REDELIVERY_AFTER_SECONDS=60

# Fernet key that encrypts connection-profile secrets at rest (required to store any secret).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable and backed up: changing it makes stored secrets undecryptable.
ENCRYPTION_KEY=

# Persistence and logging
IDEMPOTENCY_DB_PATH=./data/idempotency.sqlite3
# Admin database (connection profiles, mappings, jobs, runs, users); migrated at startup
ADMIN_DB_PATH=./data/admin.db
# An in-progress key older than this is treated as abandoned (outcome unknown)
IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=300
# Stored keys and webhook events older than this are purged
IDEMPOTENCY_TTL_HOURS=24
# How often the purge runs
IDEMPOTENCY_PURGE_INTERVAL_SECONDS=3600
LOG_LEVEL=INFO

# Admin UI and sync
# Built admin frontend served at / (relative to the working directory)
FRONTEND_DIST_DIR=./frontend/dist
# In-process cron scheduler for sync jobs, and how often it reloads the job list
SYNC_SCHEDULER_ENABLED=true
SYNC_SCHEDULER_REFRESH_SECONDS=60
# First admin, created only when no admin exists (set both or neither; password 12+ characters)
ADMIN_BOOTSTRAP_USER=
ADMIN_BOOTSTRAP_PASSWORD=
# Session cookie: Secure by default; set false only for plain-HTTP local development
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_NAME=admin_session
ADMIN_COOKIE_SAMESITE=lax
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_SESSION_IDLE_SECONDS=7200
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
ADMIN_ARGON2_TIME_COST=3
ADMIN_ARGON2_MEMORY_KIB=65536
ADMIN_ARGON2_PARALLELISM=4

# Docker Compose only (see README "Docker")
# Host port published for the connector (container port is always 8000)
CONNECTOR_PORT=8000
# Compose requires ODOO_*, WEBHOOK_SECRET, ENCRYPTION_KEY and ADMIN_BOOTSTRAP_* to be set and
# ignores FRONTEND_DIST_DIR / *_DB_PATH (the image fixes them to the /app/data volume).
# From a container, a service on the Docker host is http://host.docker.internal:<port>.
